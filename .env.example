# Copia este archivo como .env y rellena los valores reales.
# .env NUNCA se versiona (ver .gitignore).

# --- LLM (ver ADR-002) ---
# Proveedor: groq (por defecto) u ollama.
LLM_PROVIDER=groq

# API key de Groq, usada por src/extract.py para clasificar ofertas.
GROQ_API_KEY=tu_api_key_aqui
# Modelo de Groq. Si se deja vacío, se usa openai/gpt-oss-20b.
GROQ_MODEL=

# Solo si LLM_PROVIDER=ollama. Si se dejan vacíos, se usan llama3.1 y http://localhost:11434.
OLLAMA_MODEL=
OLLAMA_HOST=

# --- Fuente de ofertas (ver ADR-006) ---
# Credenciales de https://developer.adzuna.com/
ADZUNA_APP_ID=tu_app_id_aqui
ADZUNA_APP_KEY=tu_app_key_aqui

# --- Base de datos ---
# Ruta del archivo DuckDB usado por dbt y por el pipeline.
# Si se deja vacío, se usa data/devradar.duckdb (el mismo valor por defecto que dbt_project/profiles.yml).
DBT_DUCKDB_PATH=
