# Copia este archivo como .env y rellena los valores reales.
# .env NUNCA se versiona (ver .gitignore).

# API key de Groq, usada por src/extract.py para clasificar ofertas.
GROQ_API_KEY=tu_api_key_aqui

# Ruta del archivo DuckDB usado por dbt y por el pipeline.
# Si se deja vacío, se usa el valor por defecto definido en dbt_project/profiles.yml.
DBT_DUCKDB_PATH=

# Endpoint de Ollama, solo necesario si se ejecuta en modo local en vez de Groq.
# OLLAMA_HOST=http://localhost:11434
